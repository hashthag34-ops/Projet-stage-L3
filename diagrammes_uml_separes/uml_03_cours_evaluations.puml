@startuml
left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty methods
hide circle

title Diagramme de classes — Supports de cours et évaluations

class support_cours {
  +id_support : integer <<PK>>
  +id_formation : integer <<FK>>
  +id_formateur : integer <<FK>>
  +nom_fichier : varchar(255)
  +type_fichier : varchar(100)
  +chemin_fichier : varchar(500)
  +date_publication : timestamp
  +description : text
}
class evaluation {
  +id_evaluation : integer <<PK>>
  +id_apprenant : integer <<FK>>
  +id_formation : integer <<FK>>
  +id_formateur : integer <<FK>>
  +id_evaluation_sujet : integer
  +type_evaluation : varchar(150)
  +note : numeric(5,2)
  +date_evaluation : date
  +commentaire : text
}
class evaluation_sujet {
  +id_evaluation_sujet : integer <<PK>>
  +id_formation : integer <<FK>>
  +id_formateur : integer <<FK>>
  +titre : varchar(255)
  +description : text
  +duree_minutes : integer
  +obligatoire : boolean
  +statut : statut_evaluation
  +total_points : numeric(5,2)
  +date_creation : timestamp
  +date_modification : timestamp
  +date_publication : timestamp
}
class evaluation_question {
  +id_question : integer <<PK>>
  +id_evaluation_sujet : integer <<FK>>
  +numero_question : integer
  +enonce : text
  +points : numeric(5,2)
  +date_creation : timestamp
}
class evaluation_choix {
  +id_choix : integer <<PK>>
  +id_question : integer <<FK>>
  +libelle : text
  +est_correct : boolean
  +ordre : integer
}
class evaluation_tentative {
  +id_tentative : integer <<PK>>
  +id_evaluation_sujet : integer <<FK>>
  +id_apprenant : integer <<FK>>
  +date_debut : timestamp
  +date_fin : timestamp
  +note : numeric(5,2)
  +statut : statut_tentative
}
class evaluation_reponse {
  +id_reponse : integer <<PK>>
  +id_tentative : integer <<FK>>
  +id_question : integer <<FK>>
  +id_choix : integer <<FK>>
  +points_obtenus : numeric(5,2)
}
class formation
class formateur
class apprenant

formation "1" -- "0..*" support_cours
formateur "1" -- "0..*" support_cours
formation "1" -- "0..*" evaluation_sujet
formateur "1" -- "0..*" evaluation_sujet
evaluation_sujet "1" -- "0..*" evaluation_question
evaluation_question "1" -- "0..*" evaluation_choix
evaluation_sujet "1" -- "0..*" evaluation_tentative
apprenant "1" -- "0..*" evaluation_tentative
evaluation_tentative "1" -- "0..*" evaluation_reponse
evaluation_question "1" -- "0..*" evaluation_reponse
evaluation_choix "1" -- "0..*" evaluation_reponse
apprenant "1" -- "0..*" evaluation
formation "1" -- "0..*" evaluation
formateur "1" -- "0..*" evaluation

note bottom of evaluation_reponse
Le choix sélectionné doit appartenir à la question à laquelle il répond.
end note

@enduml
